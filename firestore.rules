rules_version = '2';

// REGOLE FIRESTORE COMPLETE — progetto magazzino-edile-pos
//
// Questo file contiene TUTTE le regole del progetto e va incollato per intero,
// sostituendo quello attuale. E' l'unica copia versionata: le altre app
// (magazzino-gestionale, ordini, solleciti) non hanno un proprio file.
//
// Nota sul funzionamento: le regole sono additive in OR. Se un blocco concede
// l'accesso, l'accesso e' concesso; un "allow: if false" non nega, semplicemente
// non concede. Per questo il catch-all finale non blocca le collection sopra.
//
// ---------------------------------------------------------------------------
// AGOSTO 2026 — CHIUSURA DELL'ACCESSO ANONIMO
//
// Fino a oggi tutte le collection non-scad_ avevano "allow read: if true", e
// diverse anche create/update/delete liberi. Con projectId e apiKey presenti in
// repository pubblici, questo rendeva scaricabile da chiunque l'anagrafica
// clienti (34.419 documenti), i preventivi e le pratiche di recupero crediti,
// e modificabili le pratiche e gli ordini.
//
// Ora ogni accesso richiede un utente autorizzato. Le app che leggevano in
// anonimo hanno ricevuto un login: magazzino-gestionale, ordini e solleciti.
//
// Le collection degli screener (bond_snapshots, bond_ladders, coma_snapshots)
// non compaiono piu': quelle app sono passate al progetto
// igorbonfanti-screener. I documenti restano nel database ma il catch-all li
// rende inaccessibili; si possono eliminare quando vuoi.
// ---------------------------------------------------------------------------
// SETTEMBRE 2026 — APP SCORTE E MAGAZZINIERI
//
// Entra l'app scorte (conteggio giacenze e riordino), con le collection
// scorte_*. Entrano anche due utenti nuovi, i magazzinieri, che NON sono
// aggiunti ad autorizzato(): devono poter contare la merce e nient'altro.
// Per clienti, preventivi, ordini, pratiche e assegni restano estranei
// esattamente come prima, cioe' bloccati dal catch-all.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // =======================================================================
    // CHI PUO' ACCEDERE
    // =======================================================================
    // Elenco esplicito degli UID abilitati. Volutamente piu' stretto del solo
    // "request.auth != null": quello concede l'accesso a QUALUNQUE utente
    // autenticato, e con l'apiKey pubblica basterebbe riattivare per sbaglio la
    // registrazione self-service perche' chiunque possa registrarsi e leggere
    // tutto. Con l'elenco, riaprire la registrazione non basta piu'.
    //
    // Per aggiungere una persona: creala in console e aggiungi qui il suo UID,
    // poi ripubblica le regole. Sono quattro utenti, il costo e' accettabile.
    //
    //   0nGqBTD3...  bonfanti.igor@gmail.com
    //   4Dak4tLe...  amministrazione@ilmagazzinoedile.com
    //   iJRRRJDp...  commerciale@ilmagazzinoedile.com
    //   pET8M4Mg...  carnevale.carlino@gmail.com
    function autorizzato() {
      return request.auth != null && request.auth.uid in [
        '0nGqBTD30QTsovcf7f19KASy9Eg1',
        '4Dak4tLe20O8gWtnSOh3h7Z3h5X2',
        'iJRRRJDpvSeKwqfU1bJKQ3oSNy83',
        'pET8M4MguvfvZaEwt2DilGwRUuC2'
      ];
    }

    // I magazzinieri: contano la merce, e nient'altro. Tenuti in un elenco
    // separato apposta, cosi' un domani che si aggiunge una collection nuova
    // a un'altra app non se la ritrovano aperta per distrazione.
    //
    //   g6SSbwfE...  arturo@ilmagazzinoedile.com
    //   QCW0XAmH...  charlie@ilmagazzinoedile.com
    function magazziniere() {
      return request.auth != null && request.auth.uid in [
        'g6SSbwfEfrMPZCDKLZExsUxzmDJ3',
        'QCW0XAmHr0WGjeaPYGmyuOtkW4s2'
      ];
    }

    // Chi puo' almeno leggere i dati del magazzino.
    function letturaScorte() {
      return autorizzato() || magazziniere();
    }

    // =======================================================================
    // APP MAGAZZINO (POS e preventivi)
    // =======================================================================

    // Clienti inseriti a mano dagli operatori, oltre a quelli del clienti.xlsx.
    // Letta anche da solleciti, che vi aggiunge nominativi nuovi.
    match /clienti/{docId} {
      allow read: if autorizzato();
      allow create: if autorizzato()
                    && request.resource.data.size() < 20;
      allow update, delete: if false;
    }

    // Telefoni e cantieri per cliente: dati personali di terzi.
    match /customer_meta/{docId} {
      allow read: if autorizzato();
      allow create: if autorizzato()
                    && request.resource.data.ragione is string
                    && request.resource.data.ragione.size() < 500;
      // L'update non deve poter cambiare la ragione sociale, che fa da chiave
      // logica di collegamento con l'anagrafica.
      allow update: if autorizzato()
                    && request.resource.data.ragione == resource.data.ragione;
      allow delete: if false;
    }

    // Preventivi salvati, con ID custom PREV-YYYY-NNNN.
    match /quotes/{quoteId} {
      allow read: if autorizzato();
      allow create: if autorizzato()
                    && request.resource.data.quoteId is string
                    && request.resource.data.items is list;
      allow update, delete: if false;
    }

    // Contatore atomico dei preventivi.
    match /metadata/{docId} {
      allow read: if autorizzato();
      allow write: if autorizzato()
                   && docId == 'quoteCounter'
                   && request.resource.data.value is int
                   && request.resource.data.value > 0
                   && request.resource.data.value < 1000000;
    }

    // =======================================================================
    // APP ORDINI
    // =======================================================================

    // La delete resta concessa: l'app ha un pulsante per eliminare un ordine
    // analizzato, ma ora solo a utente autorizzato.
    match /ordini_analizzati/{docId} {
      allow read: if autorizzato();
      allow create: if autorizzato() && request.resource.data.size() < 100;
      allow delete: if autorizzato();
      allow update: if false;
    }

    // =======================================================================
    // APP SOLLECITI (recupero crediti)
    // =======================================================================

    match /pratiche/{praticaId} {
      allow read, create, update: if autorizzato();
      allow delete: if false;

      // Storico delle azioni: si aggiunge, non si riscrive.
      match /logs/{logId} {
        allow read, create: if autorizzato();
        allow update, delete: if false;
      }
    }

    match /pratiche_bozze/{docId} {
      allow read, create: if autorizzato();
      allow update, delete: if false;
    }

    // =======================================================================
    // SCADENZIARIO TITOLI (assegni fornitori)
    // =======================================================================
    // Nessuna cancellazione fisica: si usa il flag "eliminato" (soft delete),
    // quindi delete e' negato ovunque tranne sulle allocazioni.

    match /scad_fornitori/{docId} {
      allow read, create, update: if autorizzato();
      allow delete: if false;
    }

    match /scad_partite/{docId} {
      allow read, create, update: if autorizzato();
      allow delete: if false;
    }

    match /scad_titoli/{docId} {
      allow read, create, update: if autorizzato();
      allow delete: if false;
    }

    // Qui la delete e' concessa: annullare l'abbinamento di un assegno a una
    // fattura e' un'operazione normale di correzione, e la riga non contiene
    // storia da conservare (titolo e partita restano).
    match /scad_allocazioni/{docId} {
      allow read, create, update, delete: if autorizzato();
    }

    match /scad_impegni/{docId} {
      allow read, create, update: if autorizzato();
      allow delete: if false;
    }

    match /scad_incassi_previsti/{docId} {
      allow read, create, update: if autorizzato();
      allow delete: if false;
    }

    // Log delle importazioni CSV: sola aggiunta, mai modificato.
    match /scad_import/{docId} {
      allow read, create: if autorizzato();
      allow update, delete: if false;
    }

    match /scad_impostazioni/{docId} {
      allow read, create, update: if autorizzato();
      allow delete: if false;
    }

    // =======================================================================
    // APP SCORTE (conteggio giacenze e riordino)
    // =======================================================================
    // I dati di base — parametri, tempi di consegna, articoli, consumi per
    // sede — li legge anche chi conta, perche' senza non sa cosa cercare ne'
    // in che colli. Scriverli invece e' roba da autorizzato(): sono i numeri
    // che decidono cosa si ordina.

    match /scorte_config/{docId} {
      allow read: if letturaScorte();
      allow write: if autorizzato();
    }

    match /scorte_tempi/{fornitore} {
      allow read: if letturaScorte();
      allow write: if autorizzato();
    }

    match /scorte_articoli/{idCodice} {
      allow read: if letturaScorte();
      allow write: if autorizzato();
    }

    // Consumi gia' elaborati: non si calcolano nell'app, arrivano
    // dall'importazione iniziale.
    match /scorte_statistiche/{idRiga} {
      allow read: if letturaScorte();
      allow write: if autorizzato();
    }

    // I conteggi delle giacenze.
    // Il magazziniere apre una rilevazione e la compila; non puo' pero'
    // riaprire quello che ha chiuso, ne' cancellare un conteggio fatto. Una
    // rilevazione chiusa e' un documento di magazzino, si corregge solo da
    // parte di chi ha la responsabilita' dei numeri.
    match /scorte_rilevazioni/{docId} {
      allow read: if letturaScorte();
      allow create: if autorizzato()
                    || (magazziniere()
                        && request.resource.data.stato == 'bozza'
                        && request.resource.data.operatore_uid == request.auth.uid);
      allow update: if autorizzato()
                    || (magazziniere() && resource.data.stato == 'bozza');
      allow delete: if autorizzato();
    }

    // Profilo applicativo: nome e sede mostrati dall'app. Non e' questo a dare
    // i permessi — quelli stanno negli elenchi di UID qui sopra — ma serve
    // all'app per sapere chi sei. Il magazziniere puo' crearsi il proprio al
    // primo accesso, non modificarlo.
    match /scorte_utenti/{uid} {
      allow read: if autorizzato() || (magazziniere() && request.auth.uid == uid);
      allow create: if autorizzato()
                    || (magazziniere()
                        && request.auth.uid == uid
                        && request.resource.data.ruolo == 'operatore');
      allow update, delete: if autorizzato();
    }

    // =======================================================================
    // Tutto il resto: nega.
    // Comprende le vecchie collection degli screener, ora sul progetto
    // igorbonfanti-screener.
    // =======================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
